# Local configuration only. On Render use Environment/Secrets instead.
AI_PROVIDER=aion
AION_API_KEY=
AION_TEXT_MODEL=aion-labs/aion-3.5-mini
APP_PASSWORD=replace-with-a-strong-private-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=./data/clearspace.sqlite
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=
# Native Linux or Windows whisper.cpp executable/model, if running outside Docker:
WHISPER_EXECUTABLE=/usr/local/bin/whisper-cli
WHISPER_MODEL=/opt/models/ggml-base.bin
